{
  "name": "jargon",
  "version": "0.2.0",
  "description": "Vibe code outbound sales tools",
  "main": "./out/main/index.js",
  "author": "jargon",
  "license": "MIT",
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "electron-vite build",
    "preview": "ELECTRON_RUN_AS_NODE= electron-vite preview",
    "typecheck": "tsc --noEmit",
    "api": "tsx src/server/standalone.ts",
    "jargon": "tsx cli/src/index.ts",
    "jargon:build": "npm run build --prefix cli",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "landing:dev": "npm run dev --prefix landing",
    "landing:build": "npm run build --prefix landing",
    "landing:preview": "npm run preview --prefix landing",
    "portal:dev": "npm run dev --prefix portal",
    "portal:build": "npm run build --prefix portal",
    "portal:preview": "npm run preview --prefix portal"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "electron-updater": "^6.6.2",
    "express": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
