{
  "openapi": "3.1.0",
  "info": {
    "title": "Jargon GTM Execution API",
    "version": "1.0.0",
    "description": "Public API for deploying workspaces and executing outbound (queue, email, voice, disposition). Tenancy is derived from the API key. Do not send org_id."
  },
  "servers": [
    {
      "url": "https://jargon-api-production.up.railway.app/v1",
      "description": "Production"
    }
  ],
  "security": [{ "bearerAuth": [] }],
  "tags": [
    { "name": "Session" },
    { "name": "Account" },
    { "name": "Workspaces" },
    { "name": "Queue" },
    { "name": "Execute" }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "getMe",
        "tags": ["Session"],
        "summary": "Current user, org, plan, and credit balance for this API key",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Me" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/account/credits": {
      "get": {
        "operationId": "getAccountCredits",
        "tags": ["Account"],
        "summary": "Remaining credits, plan grant, and wallets. Does not consume credits.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountCredits" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": ["Account"],
        "summary": "Credit and outbound usage for the current billing period",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountUsage" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/account/billing-link": {
      "post": {
        "operationId": "createBillingLink",
        "tags": ["Account"],
        "summary": "Create a Stripe Checkout or Customer Portal URL (or a dashboard URL while Stripe is pending)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BillingLinkRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BillingLink" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/prospects": {
      "get": {
        "operationId": "listProspects",
        "tags": ["Queue"],
        "summary": "List prospects already in this org (from connected CRM/warehouse snapshots). Do not cache PII locally.",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Limit to one workspace"
          },
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/ContactStatus" }
          },
          {
            "name": "q",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContactList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/prospects/{id}": {
      "get": {
        "operationId": "getProspect",
        "tags": ["Queue"],
        "summary": "Get one prospect by id",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Contact" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "tags": ["Workspaces"],
        "summary": "List workspaces for this org",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["projects"],
                  "properties": {
                    "projects": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Project" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/tools/deploy": {
      "post": {
        "operationId": "deployTool",
        "tags": ["Workspaces"],
        "summary": "Create a workspace from a prompt. Pass contacts to use that exact queue; otherwise hydrates from the connected CRM/warehouse.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeployRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeployResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/projects/{id}": {
      "get": {
        "operationId": "getProject",
        "tags": ["Workspaces"],
        "summary": "Get a workspace (not the full UI bundle)",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/projects/{id}/contacts": {
      "get": {
        "operationId": "listContacts",
        "tags": ["Queue"],
        "summary": "List contacts in a workspace",
        "parameters": [
          { "$ref": "#/components/parameters/Id" },
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/ContactStatus" }
          },
          {
            "name": "q",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Search name, company, title, email, city"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContactList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "operationId": "addContacts",
        "tags": ["Queue"],
        "summary": "Append people from any source to a workspace queue",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["contacts"],
                "additionalProperties": false,
                "properties": {
                  "contacts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": { "$ref": "#/components/schemas/DeployContact" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AddContactsResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/projects/{id}/queue/next": {
      "get": {
        "operationId": "queueNext",
        "tags": ["Queue"],
        "summary": "Next actionable contact plus current step template",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": {
            "description": "OK — contact may be null when the queue is empty",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/QueueNext" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/contacts/{id}/messages": {
      "post": {
        "operationId": "sendMessage",
        "tags": ["Execute"],
        "summary": "Send email or LinkedIn (or save a draft)",
        "parameters": [
          { "$ref": "#/components/parameters/Id" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendMessageRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": { "$ref": "#/components/schemas/Message" },
                    "creditsUsed": { "type": "number" },
                    "creditsRemaining": { "type": "number" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/Error" },
          "402": { "$ref": "#/components/responses/PaymentRequired" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/contacts/{id}/calls": {
      "post": {
        "operationId": "startCall",
        "tags": ["Execute"],
        "summary": "Start a dial session for a contact",
        "parameters": [
          { "$ref": "#/components/parameters/Id" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["call"],
                  "properties": {
                    "call": { "$ref": "#/components/schemas/Call" },
                    "creditsUsed": { "type": "number" },
                    "creditsRemaining": { "type": "number" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "402": { "$ref": "#/components/responses/PaymentRequired" },
          "422": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/calls/{id}/complete": {
      "post": {
        "operationId": "completeCall",
        "tags": ["Execute"],
        "summary": "Complete an open call with a disposition",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["disposition"],
                "properties": {
                  "disposition": { "$ref": "#/components/schemas/ContactStatus" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["call", "next"],
                  "properties": {
                    "call": { "$ref": "#/components/schemas/Call" },
                    "next": { "$ref": "#/components/schemas/QueueNext" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/contacts/{id}/disposition": {
      "post": {
        "operationId": "disposition",
        "tags": ["Execute"],
        "summary": "Log an outcome without an open call",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DispositionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["contact", "next"],
                  "properties": {
                    "contact": { "$ref": "#/components/schemas/Contact" },
                    "next": { "$ref": "#/components/schemas/QueueNext" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/contacts/{id}/notes": {
      "post": {
        "operationId": "addNote",
        "tags": ["Execute"],
        "summary": "Append a note to a contact",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["note"],
                "properties": {
                  "note": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["contact"],
                  "properties": {
                    "contact": { "$ref": "#/components/schemas/Contact" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "jarg_",
        "description": "API key from the dashboard or `jargon api-keys create`. Tenancy is implied."
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 1 },
        "description": "Required on dial/send. Replay within 24h returns the original response (Idempotent-Replay: true)."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or non-API-key bearer token",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Not found in this org",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "RateLimited": {
        "description": "Too many send or dial requests in the current 15-minute window",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "PaymentRequired": {
        "description": "Live send/dial requires credits. Check remaining credits or open billingUrl.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/InsufficientCredits" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" },
          "billingUrl": { "type": "string" },
          "remaining": { "type": "number" }
        }
      },
      "InsufficientCredits": {
        "type": "object",
        "required": ["error", "code", "billingUrl", "remaining"],
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string", "enum": ["insufficient_credits"] },
          "billingUrl": { "type": "string" },
          "remaining": { "type": "number" }
        }
      },
      "ContactStatus": {
        "type": "string",
        "enum": [
          "queued",
          "active",
          "completed",
          "replied",
          "no_answer",
          "interested",
          "not_interested"
        ]
      },
      "ProjectKind": {
        "type": "string",
        "enum": ["dialer", "sequencer", "cadence", "list", "today", "generic"]
      },
      "User": {
        "type": "object",
        "required": ["id", "email", "name"],
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "Org": {
        "type": "object",
        "required": ["id", "name", "slug"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" }
        }
      },
      "Me": {
        "type": "object",
        "required": ["user", "org", "environment", "outbound", "plan", "credits", "payments", "claude"],
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "org": { "$ref": "#/components/schemas/Org" },
          "environment": { "type": "string", "enum": ["live", "sandbox"] },
          "outbound": {
            "type": "object",
            "required": ["email", "voice", "linkedin"],
            "properties": {
              "email": { "type": "string", "enum": ["live", "demo", "sandbox"] },
              "voice": { "type": "string", "enum": ["live", "demo", "sandbox"] },
              "linkedin": { "type": "string", "enum": ["live", "demo", "sandbox"] }
            }
          },
          "plan": { "$ref": "#/components/schemas/AccountPlan" },
          "credits": { "$ref": "#/components/schemas/AccountCreditBalance" },
          "payments": { "$ref": "#/components/schemas/Payments" },
          "claude": { "$ref": "#/components/schemas/ClaudeConnector" }
        }
      },
      "ClaudeConnector": {
        "type": "object",
        "required": ["connected", "mcpUrl", "connectorUrl"],
        "properties": {
          "connected": { "type": "boolean" },
          "connectedAt": { "type": ["string", "null"] },
          "mcpUrl": { "type": "string" },
          "connectorUrl": {
            "type": "string",
            "description": "Opens Claude’s Add custom connector dialog with Jargon prefilled"
          }
        }
      },
      "AccountPlan": {
        "type": "object",
        "required": ["id", "name", "creditsIncluded", "status"],
        "properties": {
          "id": { "type": "string", "enum": ["free", "team", "scale"] },
          "name": { "type": "string" },
          "creditsIncluded": { "type": "number" },
          "status": { "type": "string", "enum": ["active", "trialing", "past_due", "canceled"] }
        }
      },
      "AccountCreditBalance": {
        "type": "object",
        "required": ["remaining", "included", "billingUrl"],
        "properties": {
          "remaining": { "type": "number" },
          "included": { "type": "number" },
          "periodStart": { "type": ["string", "null"] },
          "periodEnd": { "type": ["string", "null"] },
          "billingUrl": { "type": "string" },
          "wallets": { "type": "array", "items": { "$ref": "#/components/schemas/CreditWallet" } },
          "creditTopups": { "type": "array", "items": { "$ref": "#/components/schemas/CreditTopup" } }
        }
      },
      "AccountCredits": {
        "type": "object",
        "required": [
          "orgId",
          "plan",
          "planName",
          "status",
          "credits",
          "included",
          "billingUrl",
          "payments"
        ],
        "properties": {
          "orgId": { "type": "string" },
          "plan": { "type": "string", "enum": ["free", "team", "scale"] },
          "planName": { "type": "string" },
          "status": { "type": "string" },
          "credits": { "type": "number" },
          "included": { "type": "number" },
          "periodStart": { "type": ["string", "null"] },
          "periodEnd": { "type": ["string", "null"] },
          "billingUrl": { "type": "string" },
          "payments": { "$ref": "#/components/schemas/Payments" },
          "wallets": { "type": "array", "items": { "$ref": "#/components/schemas/CreditWallet" } },
          "creditTopups": { "type": "array", "items": { "$ref": "#/components/schemas/CreditTopup" } }
        }
      },
      "CreditWallet": {
        "type": "object",
        "required": ["type", "credits"],
        "properties": {
          "type": { "type": "string", "enum": ["recurring", "topup"] },
          "credits": { "type": "number" },
          "nextRefreshAt": { "type": ["string", "null"] },
          "expiresAt": { "type": ["string", "null"] }
        }
      },
      "CreditTopup": {
        "type": "object",
        "required": ["id", "type", "grantedCredits", "remainingCredits", "grantedAt"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["purchase", "granted", "auto_topup"] },
          "grantedCredits": { "type": "number" },
          "remainingCredits": { "type": "number" },
          "grantedAt": { "type": "string" },
          "expiresAt": { "type": ["string", "null"] }
        }
      },
      "Payments": {
        "type": "object",
        "required": ["provider", "ready"],
        "properties": {
          "provider": { "type": "string", "enum": ["stripe", "pending"] },
          "ready": { "type": "boolean" }
        }
      },
      "AccountUsage": {
        "type": "object",
        "required": ["totals", "daily", "byProject"],
        "properties": {
          "periodStart": { "type": ["string", "null"] },
          "periodEnd": { "type": ["string", "null"] },
          "totals": { "$ref": "#/components/schemas/UsageTotals" },
          "daily": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/components/schemas/UsageTotals" },
                {
                  "type": "object",
                  "required": ["day"],
                  "properties": { "day": { "type": "string" } }
                }
              ]
            }
          },
          "byProject": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/components/schemas/UsageTotals" },
                {
                  "type": "object",
                  "required": ["projectId", "projectName"],
                  "properties": {
                    "projectId": { "type": "string" },
                    "projectName": { "type": "string" }
                  }
                }
              ]
            }
          }
        }
      },
      "UsageTotals": {
        "type": "object",
        "required": ["credits", "emails", "calls", "linkedin"],
        "properties": {
          "credits": { "type": "number" },
          "emails": { "type": "integer" },
          "calls": { "type": "integer" },
          "linkedin": { "type": "integer" }
        }
      },
      "BillingLinkRequest": {
        "type": "object",
        "required": ["intent"],
        "additionalProperties": false,
        "properties": {
          "intent": { "type": "string", "enum": ["upgrade", "topup", "portal"] },
          "plan": { "type": "string", "enum": ["team", "scale"] },
          "packId": {
            "type": "string",
            "enum": ["credits_500", "credits_2000", "credits_10000"]
          }
        }
      },
      "BillingLink": {
        "type": "object",
        "required": ["url", "provider"],
        "properties": {
          "url": { "type": "string" },
          "provider": { "type": "string", "enum": ["stripe", "pending"] },
          "message": { "type": "string" }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "prompt",
          "contactCount",
          "dashboardPath",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "$ref": "#/components/schemas/ProjectKind" },
          "prompt": { "type": "string" },
          "segment": { "type": "string" },
          "description": { "type": "string" },
          "contactCount": { "type": "integer" },
          "dashboardPath": {
            "type": "string",
            "description": "Path on jargonlabs.co, e.g. /tools/{id}"
          },
          "createdAt": { "type": "integer" },
          "updatedAt": { "type": "integer" }
        }
      },
      "DeployContact": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "company": { "type": "string" },
          "title": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "city": { "type": "string" },
          "linkedinUrl": { "type": "string" },
          "accountName": { "type": "string" },
          "notes": { "type": "string" },
          "context": { "type": "array", "items": { "type": "string" } },
          "companyDomain": { "type": "string" }
        }
      },
      "DeployRequest": {
        "type": "object",
        "required": ["prompt"],
        "additionalProperties": false,
        "properties": {
          "prompt": { "type": "string", "minLength": 1 },
          "contacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/DeployContact" },
            "description": "Exact people for the queue. When set, HubSpot/Railway are not used."
          }
        }
      },
      "DeployResult": {
        "type": "object",
        "required": ["projectId", "contactCount", "dashboardPath", "project"],
        "properties": {
          "projectId": { "type": "string" },
          "contactCount": { "type": "integer" },
          "dashboardPath": { "type": "string" },
          "project": { "$ref": "#/components/schemas/Project" }
        }
      },
      "AddContactsResult": {
        "type": "object",
        "required": ["added", "contactCount", "contacts"],
        "properties": {
          "added": { "type": "integer" },
          "contactCount": { "type": "integer" },
          "contacts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Contact" }
          }
        }
      },
      "Contact": {
        "type": "object",
        "required": [
          "id",
          "projectId",
          "name",
          "company",
          "title",
          "email",
          "phone",
          "status",
          "stepIndex"
        ],
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "name": { "type": "string" },
          "company": { "type": "string" },
          "title": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "city": { "type": "string" },
          "status": { "$ref": "#/components/schemas/ContactStatus" },
          "stepIndex": { "type": "integer" },
          "notes": { "type": "string" },
          "linkedinUrl": { "type": "string" },
          "accountName": { "type": "string" },
          "context": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "integer" },
          "updatedAt": { "type": "integer" }
        }
      },
      "ContactList": {
        "type": "object",
        "required": ["contacts", "total", "limit", "offset"],
        "properties": {
          "contacts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Contact" }
          },
          "total": { "type": "integer" },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "Step": {
        "type": "object",
        "required": ["id", "channel", "label", "order"],
        "properties": {
          "id": { "type": "string" },
          "day": { "type": "integer" },
          "channel": { "type": "string", "enum": ["email", "call", "linkedin"] },
          "label": { "type": "string" },
          "subject": { "type": "string" },
          "body": { "type": "string" },
          "order": { "type": "integer" }
        }
      },
      "QueueNext": {
        "type": "object",
        "required": ["contact", "step", "remaining"],
        "properties": {
          "contact": { "oneOf": [{ "$ref": "#/components/schemas/Contact" }, { "type": "null" }] },
          "step": { "oneOf": [{ "$ref": "#/components/schemas/Step" }, { "type": "null" }] },
          "remaining": { "type": "integer" }
        }
      },
      "SendMessageRequest": {
        "type": "object",
        "required": ["body"],
        "additionalProperties": false,
        "properties": {
          "channel": { "type": "string", "enum": ["email", "linkedin"], "default": "email" },
          "status": { "type": "string", "enum": ["draft", "queued", "sent"], "default": "sent" },
          "subject": { "type": "string" },
          "body": { "type": "string" }
        }
      },
      "Message": {
        "type": "object",
        "required": ["id", "contactId", "projectId", "channel", "status", "body"],
        "properties": {
          "id": { "type": "string" },
          "contactId": { "type": "string" },
          "projectId": { "type": "string" },
          "channel": { "type": "string", "enum": ["email", "linkedin"] },
          "status": { "type": "string", "enum": ["draft", "queued", "sent", "failed"] },
          "subject": { "type": "string" },
          "body": { "type": "string" },
          "mode": { "type": "string", "enum": ["demo", "gmail", "heyreach"] },
          "createdAt": { "type": "integer" },
          "sentAt": { "type": "integer" }
        }
      },
      "Call": {
        "type": "object",
        "required": ["id", "contactId", "projectId", "phase", "mode", "startedAt"],
        "properties": {
          "id": { "type": "string" },
          "contactId": { "type": "string" },
          "projectId": { "type": "string" },
          "phase": {
            "type": "string",
            "enum": ["dialing", "ringing", "connected", "completed", "failed"]
          },
          "disposition": { "$ref": "#/components/schemas/ContactStatus" },
          "mode": { "type": "string", "enum": ["demo", "twilio"] },
          "startedAt": { "type": "integer" },
          "connectedAt": { "type": "integer" },
          "endedAt": { "type": "integer" }
        }
      },
      "DispositionRequest": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": { "$ref": "#/components/schemas/ContactStatus" },
          "note": { "type": "string" },
          "advanceStep": { "type": "boolean" }
        }
      }
    }
  }
}
