# Hosted multi-tenant API
PORT=8787
JARGON_API_HOST=0.0.0.0
JARGON_PUBLIC_URL=https://api.your-domain.com
# Browser URL for shared rep preview pages (required for CLI deploy + share links)
JARGON_PREVIEW_URL=http://127.0.0.1:5173
# Customer account portal (login, builds, billing)
JARGON_PORTAL_URL=http://127.0.0.1:5181
JARGON_DB_PATH=./data/jargon-db.json
JARGON_ENCRYPTION_KEY=replace-with-long-random-string
JARGON_DEEP_LINK=jargon
# Set to 1 to force demo providers even if keys exist
# JARGON_DEMO_MODE=1

# Desktop production builds point at the hosted API
# JARGON_API_URL=https://api.your-domain.com

# HubSpot OAuth app
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.companies.read oauth

# Google / Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/userinfo.email

# Twilio Voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_FROM_NUMBER=

# Apollo people search + enrichment
# Loaded automatically — orgs get an Apollo connection on login / API boot.
APOLLO_API_KEY=

# Crustdata people search (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# Supabase context layer — prospects table in your project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: use anon key with RLS instead of service role
# SUPABASE_ANON_KEY=
SUPABASE_PROSPECTS_TABLE=jargon_prospects

# Stripe billing (optional — enables Pro checkout in portal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
