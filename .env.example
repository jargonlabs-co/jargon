# Public Jargon PRODUCT API — do not reuse with private outbound-ops
# See docs/SEPARATION.md
PORT=8787
JARGON_API_HOST=0.0.0.0
JARGON_PUBLIC_URL=https://api.your-domain.com
JARGON_APP_URL=http://127.0.0.1:5180
JARGON_DB_PATH=./data/jargon-db.json
# Railway Postgres — product DB only (never share with outbound-ops)
# DATABASE_URL=postgres://user:pass@host:5432/railway
JARGON_ENCRYPTION_KEY=replace-with-long-random-string
# Set to 1 to force demo providers even if keys exist
# JARGON_DEMO_MODE=1

# HubSpot — customer data layer (OAuth app is Jargon's; portal is the customer's)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.companies.read oauth

# Railway — customer warehouse (Login with Railway OAuth)
# Create app: Railway workspace → Developer → New OAuth App
# Redirect URI: ${JARGON_PUBLIC_URL}/oauth/railway/callback
RAILWAY_CLIENT_ID=
RAILWAY_CLIENT_SECRET=
# RAILWAY_OAUTH_SCOPES=openid email profile offline_access project:member

# Supabase Auth — user login / passwords live here (not in Railway JSON/Postgres app state)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Billing tables: run docs/supabase-billing.sql in the Supabase SQL editor

# Google / Gmail — Jargon managed sending (customers never connect Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/userinfo.email
# Single mailbox (or first member of GMAIL_POOL_JSON)
GMAIL_REFRESH_TOKEN=
# Optional pool: [{"id":"m1","refreshToken":"...","label":"ops1"}, ...]
# GMAIL_POOL_JSON=
# JARGON_EMAIL_DAILY_PER_ORG=50

# Stripe — required for paid plans / top-ups at scale
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
# Webhook URL: ${JARGON_PUBLIC_URL}/billing/stripe/webhook
# After Atlas: set these on Railway and confirm /health shows stripe: live

# Optional: Claude / local agents should use a sandbox API key (jarg_test_…)
# Create with: jargon api-keys create --name "dev" --sandbox
# JARGON_TEST_KEY=

# LLM compile — free-form deploy prompts → structured workspace specs
# Optional LLM compile (off by default). Prefer Anthropic when set; otherwise OpenAI.
# Rule catalog in outboundIntents.ts handles LinkedIn / phone / email / multi without tokens.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# JARGON_COMPILE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# JARGON_COMPILE_OPENAI_MODEL=gpt-4o-mini
# Set to 1 to enable LLM-assisted compile
# JARGON_LLM_COMPILE=1

# Twilio Voice (fallback if Plivo is not set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_FROM_NUMBER=

# Plivo Voice (preferred) — browser softphone via SIP endpoint + XML application
# Console: https://console.plivo.com/dashboard/
# 1. Copy Auth ID / Auth Token
# 2. Buy a voice-enabled number
# 3. Create a Voice application:
#    Answer URL  ${JARGON_PUBLIC_URL}/voice/plivo/answer
#    Hangup URL  ${JARGON_PUBLIC_URL}/voice/plivo/hangup
# 4. Create a SIP endpoint attached to that application (Voice → Endpoints)
#    Use the full username Plivo returns (it appends digits)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
PLIVO_APP_ID=
PLIVO_ENDPOINT_USERNAME=
PLIVO_ENDPOINT_PASSWORD=
# Optional DID/SIP pool (exclusive sticky — one org per DID). Use the username Plivo *returns*
# after endpoint create (it appends a 12-digit suffix). Do not put endpoint passwords here — softphone auth is JWT.
# PLIVO_POOL_JSON=[{"id":"v1","fromNumber":"+1...","endpointUsername":"jargonv1131031145958"}]
# JARGON_CONCURRENT_CALLS_PER_ORG=1
# JARGON_VOICE_DAILY_PER_ORG=100

# People Data Labs (optional — mcp-pdl MCP server)
# PDL_API_KEY=
# PDL_API_URL=https://api.peopledatalabs.com/v5

# HeyReach LinkedIn — Jargon managed seats (customers never bring a key)
HEYREACH_API_KEY=
# One seat, or comma-separated pool: HEYREACH_SENDER_ACCOUNT_IDS=111,222,333
HEYREACH_SENDER_ACCOUNT_ID=
# HEYREACH_SENDER_ACCOUNT_IDS=
# JARGON_LINKEDIN_DAILY_PER_ORG=20
# Campaign for cold leads with no existing conversation; defaults to the sender's first running campaign
HEYREACH_CAMPAIGN_ID=
