{
  "name": "jargon",
  "version": "0.3.0",
  "description": "CLI-deployed outbound tools — HubSpot data, Jargon send",
  "author": "jargon",
  "license": "MIT",
  "scripts": {
    "dev": "npm run landing:dev",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript openapi.json -o src/api/types.gen.ts",
    "api": "tsx src/server/standalone.ts",
    "jargon": "tsx cli/src/index.ts",
    "jargon:build": "npm run build --prefix cli",
    "mcp": "tsx mcp/src/index.ts",
    "mcp:build": "npm run build --prefix mcp",
    "landing:dev": "npm run dev --prefix landing",
    "landing:build": "npm run build --prefix landing",
    "landing:preview": "npm run preview --prefix landing"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@supabase/supabase-js": "^2.115.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twilio": "^6.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
