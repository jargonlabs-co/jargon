{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix landing",
  "buildCommand": "npm run build --prefix landing",
  "outputDirectory": "landing/dist",
  "rewrites": [
    {
      "source": "/((?!favicon\\.ico|favicon\\.svg|favicon\\.png|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
